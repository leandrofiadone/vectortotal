---
const navLinks = [
  { href: '/',       label: 'inicio' },
  { href: '/salas',  label: 'salas'  },
  { href: '/mapa',   label: 'mapa'   },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && (currentPath === `${href}/` || currentPath.startsWith(`${href}/`)));
---

<header class="site-header" transition:animate="none">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="vectortotal — inicio" transition:name="site-logo">
      <span class="logo-name">vectortotal</span>
      <span class="cursor">_</span>
    </a>

    <nav class="nav" id="siteNav" aria-label="Principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-right">
      <button type="button" class="search-btn" data-search-open aria-label="Buscar (Ctrl+K)" aria-keyshortcuts="Control+K">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-btn-label">buscar</span>
        <kbd class="search-btn-kbd">ctrl k</kbd>
      </button>
      <a
        href="https://github.com/leandrofiadone"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a
        href="https://leanfiadone.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label="Portfolio"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
      <button type="button" class="nav-toggle" aria-label="Menú" aria-expanded="false" aria-controls="siteNav" id="navToggle">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 12, 16, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-name {
    font-family: var(--mono);
    font-size: 1.05rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .cursor {
    font-family: var(--mono);
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 3px;
    letter-spacing: 0.05em;
    transition: all 0.2s;
    position: relative;
  }

  .nav-link::before {
    content: './';
    opacity: 0;
    transition: opacity 0.2s;
  }

  .nav-link:hover::before,
  .nav-link.active::before { opacity: 1; }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-bright);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link.active { color: var(--accent); }

  /* Social + toggle */
  .header-right {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    margin-right: 6px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .search-btn:hover {
    color: var(--text-bright);
    border-color: rgba(0, 229, 255, 0.35);
  }

  .search-btn-kbd {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 3px;
    color: var(--text-dim);
    text-decoration: none;
    transition: all 0.2s;
  }

  .social-link:hover {
    color: var(--accent);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-dim);
    transition: all 0.2s;
  }

  @media (max-width: 820px) {
    .search-btn-label, .search-btn-kbd { display: none; }
    .search-btn { width: 34px; padding: 0; justify-content: center; margin-right: 0; background: none; border-color: transparent; }
  }

  @media (max-width: 640px) {
    .header-inner { gap: 8px; height: 56px; }
    .logo-name { font-size: 0.95rem; }
    .nav { display: none; }
    .nav-toggle { display: flex; }
    .nav.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--bg2);
      border-bottom: 1px solid var(--border);
      padding: 10px;
      gap: 2px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.3);
    }
    .nav.open .nav-link {
      padding: 10px 12px;
      font-size: 0.9rem;
    }
    .social-link { width: 32px; height: 32px; }
  }

  @media (max-width: 380px) {
    .header-inner { gap: 4px; }
    .social-link { width: 30px; height: 30px; }
    .nav-toggle { width: 30px; height: 30px; padding: 4px; }
  }
</style>

<script>
  let escController = new AbortController();

  document.addEventListener('astro:page-load', () => {
    // Evita acumular el listener de Escape entre navegaciones
    escController.abort();
    escController = new AbortController();

    const toggle = document.getElementById('navToggle');
    const nav = document.querySelector('.nav');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    // Cerrado al llegar a una página nueva
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));

    // Escape cierra el menú mobile
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && nav.classList.contains('open')) { setOpen(false); toggle.focus(); }
    }, { signal: escController.signal });
  });
</script>
