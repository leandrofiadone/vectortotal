---
import PostLayout from '../../../../layouts/PostLayout.astro';
import { getPublishedPosts, type Post } from '../../../../utils/posts';
import { toSlug } from '../../../../utils/slug';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .filter(p => p.data.series && p.data.subsection)
    .map(post => ({
      params: {
        series: post.data.series!,
        subsection: toSlug(post.data.subsection!),
        slug: post.slug,
      },
      props: { post },
    }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// SeriesNav solo muestra posts de la misma subsección
const seriesPosts = (await getPublishedPosts()).filter(
  p => p.data.series === post.data.series && p.data.subsection === post.data.subsection
);
---

<PostLayout post={post} headings={headings} seriesPosts={seriesPosts}>
  <Content />
</PostLayout>
