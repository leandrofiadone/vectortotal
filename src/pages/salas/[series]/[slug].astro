---
import PostLayout from '../../../layouts/PostLayout.astro';
import { getPublishedPosts, postUrl, type Post } from '../../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .filter(p => p.data.series)
    .map(post => ({
      params: { series: post.data.series!, slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Los posts con subsección viven en /salas/<serie>/<subsección>/<slug>.
// Esta ruta queda solo como redirect para no duplicar contenido.
if (post.data.subsection) {
  return Astro.redirect(postUrl(post), 301);
}

const { Content, headings } = await post.render();
const seriesPosts = (await getPublishedPosts()).filter(p => p.data.series === post.data.series);
---

<PostLayout post={post} headings={headings} seriesPosts={seriesPosts}>
  <Content />
</PostLayout>
