---
import { getPublishedPosts, postUrl } from '../../utils/posts';

// URLs viejas /posts/<slug> → URL canónica del post.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .filter(p => p.data.series)
    .map(post => ({ params: { slug: post.slug }, props: { target: postUrl(post) } }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
